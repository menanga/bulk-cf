# Gmail credentials
GMAIL_EMAIL=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# Cloudflare password (shared password for all accounts, min 5 chars)
CF_PASSWORD=

# 9router
NINE_ROUTER_URL=https://your-9router-instance.com
NINE_ROUTER_PASSWORD=your-9router-password

# Toggle tag_provider() after a successful deploy (true/1/yes = on, default: on)
NINE_ROUTER_TAG_PROVIDER=true

# Domains
DOMAINS_FILE=domains.txt
DOMAINS=

# Batch settings
MAX_ACCOUNTS=0
BATCH_SIZE=10
DELAY_ACCOUNT=600
DELAY_BATCH=3600
HEADLESS=false

# Output
CSV_OUTPUT_PATH=successful_accounts.csv

# Docker
DOCKER_ENV=
